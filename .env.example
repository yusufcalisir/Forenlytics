# ==============================================================================
# Forenlytics Docker Compose Environment Configuration
# ==============================================================================

# Web Dashboard Port
FRONTEND_PORT=3000

# Backend API Port
BACKEND_PORT=8000

# Offline / Air-Gapped Modes (1 = True, 0 = False)
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1

# Storage Paths inside host machine
DATA_PATH=./data
MODELS_PATH=./models
